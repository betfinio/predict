{
	"name": "@betfinio/predict",
	"private": true,
	"version": "1.0.0",
	"scripts": {
		"prebuild": "graphclient build",
		"build": "rsbuild build",
		"check": "biome check",
		"dev": "bun run build:schema:dev && rsbuild dev --open",
		"prod": "bun run build:schema:prod && rsbuild dev --env-mode production --open",
		"local": "bun run build:schema:local && rsbuild dev --env-mode localhost --open",
		"format": "biome format --write",
		"preview": "rsbuild preview",
		"build:schema:local": "dotenv -e .env.localhost.local -- graphclient build",
		"build:schema:dev": "dotenv -e .env.development.local -- graphclient build",
		"build:schema:prod": "dotenv -e .env.production.local -- graphclient build",
		"secret:dev": "bun run secret.ts -- development dev",
		"secret:prod": "bun run secret.ts -- production prod/io"
	},
	"dependencies": {
		"@betfinio/abi": "^2.2.0",
		"@betfinio/components": "^1.3.5",
		"@betfinio/ui": "^1.0.11",
		"@module-federation/enhanced": "^0.7.7",
		"@nivo/bar": "^0.87.0",
		"@tanstack/react-query": "^5.62.2",
		"@tanstack/react-router": "^1.85.4",
		"@tanstack/react-table": "^8.20.5",
		"class-variance-authority": "^0.7.1",
		"consola": "^3.2.3",
		"framer-motion": "^11.12.0",
		"graphql": "^16.9.0",
		"i18next": "^24.0.5",
		"i18next-browser-languagedetector": "^8.0.0",
		"i18next-icu": "^2.3.0",
		"intl-messageformat": "^10.7.7",
		"lefthook": "^1.8.5",
		"lucide-react": "^0.417.0",
		"luxon": "^3.5.0",
		"react": "^18.3.1",
		"react-circular-progressbar": "^2.1.0",
		"react-dom": "^18.3.1",
		"react-i18next": "^15.1.3",
		"react-number-format": "^5.4.2",
		"react-ts-tradingview-widgets": "^1.2.5",
		"tailwind-merge": "^2.5.5",
		"tailwindcss": "^3.4.15",
		"tailwindcss-animate": "^1.0.7",
		"wagmi": "^2.13.3"
	},
	"devDependencies": {
		"@aws-sdk/client-secrets-manager": "^3.699.0",
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.6.0",
		"@commitlint/config-conventional": "^19.6.0",
		"@graphprotocol/client-cli": "^3.0.7",
		"@module-federation/rsbuild-plugin": "^0.8.0",
		"@rsbuild/core": "^1.1.7",
		"@rsbuild/plugin-react": "^1.0.7",
		"@tanstack/router-plugin": "^1.85.3",
		"@types/bun": "^1.1.14",
		"@types/luxon": "^3.4.2",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"typescript": "^5.7.2"
	}
}
